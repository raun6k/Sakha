# Optional API runtime configuration; credentials remain on the backend.
# Strands provider: openai (default) or bedrock.
SAKHA_STRANDS_PROVIDER=openai
OPENAI_API_KEY=
SAKHA_OPENAI_MODEL=
# Bedrock when SAKHA_STRANDS_PROVIDER=bedrock. Use AWS credentials or a bearer key.
AWS_REGION=
SAKHA_BEDROCK_MODEL_ID=
SAKHA_BEDROCK_API_KEY=
# Web search fallback: Tavily, then Exa, then DuckDuckGo, then cached snippets.
TAVILY_API_KEY=
EXA_API_KEY=
# Set to 0 to skip Exa's no-key attempt.
SAKHA_EXA_FREE_TIER=
SAKHA_CODEX_ENABLED=false
SAKHA_PORT=4310
# Optional Codex model; uses the existing installed Codex login.
SAKHA_CODEX_MODEL=gpt-6-luna
# Codex web search: disabled (default), cached, or live. Live is the only mode that opens network.
SAKHA_CODEX_WEB_SEARCH=disabled
# Optional account holding an existing OpenAI API key in the OS keyring.
SAKHA_OPENAI_KEYRING_ACCOUNT=
# Optional local SQLite path; default uses the OS application-data directory.
SAKHA_DATABASE_PATH=
