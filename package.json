{
  "name": "sakha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:server": "pnpm --filter @sakha/server dev",
    "dev:web": "pnpm --filter @sakha/web dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:agents": "tsx apps/server/src/eval-agents.ts",
    "build": "pnpm --filter @sakha/web build && tsc -p apps/server/tsconfig.build.json && tsx apps/server/src/build-assets.ts",
    "start": "node --env-file-if-exists=.env --conditions=sakha-release apps/server/dist/apps/server/src/index.js",
    "operator": "node --env-file-if-exists=.env --import tsx apps/server/src/cli.ts",
    "test:browser": "playwright test -c apps/web/integration.playwright.config.ts",
    "test:demo": "playwright test -c apps/web/playwright.config.ts",
    "demo:init": "sh scripts/sakha-demo init",
    "demo:reset": "sh scripts/sakha-demo reset",
    "demo:start": "sh scripts/sakha-demo start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/better-sqlite3": "7.6.13",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "@playwright/test": "1.64.0"
  }
}
